rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // SECURITY FIX: Use correct field (isAdmin boolean) instead of role == 'admin'
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Public Profiles — SECURITY FIX: Block reading sensitive 2FA fields
    // 2FA secrets are now stored in users/{uid}/private/settings (server-only)
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if (isOwner(userId) || isAdmin()) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('twoFactorBackupCodes' in request.resource.data) &&
        !('twoFactorSecret' in request.resource.data);
      allow delete: if isOwner(userId) || isAdmin();

      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
      match /login_history/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Users — SECURITY FIX: Restrict reads to owner/admin, block isAdmin writes
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(userId) || isAdmin()) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordReset' in request.resource.data) &&
        (isAdmin() || !('isAdmin' in request.resource.data));
      allow delete: if isOwner(userId) || isAdmin();
      
      // Sensitive private data in subcollection
      match /private/{document} {
        allow read, write: if isOwner(userId);
      }
    }

    // Conversations
    match /conversations/{convoId} {
      allow read: if isSignedIn() && 
        request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && 
        request.auth.uid in request.resource.data.participants;
        
      // Prevent participants array manipulation
      allow update: if isSignedIn() && 
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
        
      // Only creator or participant can delete entire conversation
      allow delete: if isSignedIn() && 
        (resource.data.createdBy == request.auth.uid || request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        allow read: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants && 
          request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants && 
          resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants && 
          resource.data.senderId == request.auth.uid;
      }
    }


    // Notifications — SECURITY FIX: Added 'messages' and 'casting' to allowed types
    match /notifications/{notifId} {
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.recipientId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
         
      allow create: if isSignedIn() && 
        (request.resource.data.senderId == request.auth.uid || isAdmin()) &&
        request.resource.data.recipientId is string &&
        (isAdmin() || request.resource.data.type in [
          'message', 'messages', 'follow', 'casting', 'casting_match',
          'review', 'call_missed', 'call_ended'
        ]);
        
      allow update, delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.recipientId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
    }

    // Casting Calls
    match /casting_calls/{callId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && 
        (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Applications
    match /applications/{appId} {
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.creatorId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Saved Calls
    match /saved_calls/{saveId} {
      allow read, delete: if isSignedIn() && 
        resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid;
    }

    // WebRTC Calls
    match /calls/{callId} {
      allow read, update, delete: if isSignedIn() && 
        (resource.data.callerId == request.auth.uid || 
         resource.data.calleeId == request.auth.uid);
      allow create: if isSignedIn() && 
        request.resource.data.callerId == request.auth.uid;

      match /callerCandidates/{candId} {
        allow read, write: if isSignedIn() && 
          (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || 
           get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
      match /calleeCandidates/{candId} {
        allow read, write: if isSignedIn() && 
          (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || 
           get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
    }

    // OTP Codes (2FA)
    match /otpCodes/{userId} {
      allow read, write: if false;
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && 
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.targetType in [
          'user', 'casting', 'message'
        ] &&
        request.resource.data.reason in [
          'spam', 'harassment', 'inappropriate',
          'fake_profile', 'scam', 'other'
        ];
      allow update, delete: if isAdmin();
    }

    // Global Settings
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Logs
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Follows
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && 
        resource.data.followerId == request.auth.uid;
    }

    // Reviews — SECURITY FIX: Use resource.data (existing doc) for auth
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    // Data Export Requests
    match /data_export_requests/{reqId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // One-time tokens (server-use only)
    match /one_time_tokens/{tokenId} {
      allow read, write: if false;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
