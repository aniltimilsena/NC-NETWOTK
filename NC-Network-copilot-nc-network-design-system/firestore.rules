rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // User Profiles
    match /profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);

      // Sessions sub-collection (client-side active sessions track)
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      // Login History sub-collection (client-side logins audit track)
      match /login_history/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Conversations
    match /conversations/{convoId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      // Messages sub-collection
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow delete: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants && resource.data.senderId == request.auth.uid;
      }
    }

    // Story Collections
    match /stories/{storyId} {
      allow read: if true;
      allow write: if false;
    }

    // Story Replies
    match /story_replies/{replyId} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow write: if false;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.recipientId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.recipientId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // Casting Calls
    match /casting_calls/{callId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Applications
    match /applications/{appId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.creatorId == request.auth.uid);
      allow create, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.creatorId == request.auth.uid);
    }

    // Saved Calls
    match /saved_calls/{saveId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // WebRTC Calls
    match /calls/{callId} {
      allow read, update, delete: if isSignedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.callerId == request.auth.uid;

      match /callerCandidates/{candId} {
        allow read, write: if isSignedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }

      match /calleeCandidates/{candId} {
        allow read, write: if isSignedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
    }

    // Reports
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Global Settings
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin Logs
    match /admin_logs/{logId} {
      allow read, write: if false;
    }

    // Follows
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.reviewerId == request.auth.uid;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
