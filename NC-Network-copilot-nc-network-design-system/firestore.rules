rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // FIX #9: Admin SDK (used for admin_logs writes) bypasses these rules entirely.
    // The write: false rule below is intentional — no client writes permitted.
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // FIX #7: profiles read is still public (required for discovery/search).
    // NOTE: Sensitive fields (fcmToken, fcmTokens, twoFactorBackupCodes, twoFactorSecret)
    // must NOT be stored on the profiles document. They belong in users/{uid}/private.
    // The Express server proxy (/api/profiles/:userId) already strips these before returning.
    // FIX #2: profiles update blocks writing of arbitrary URLs — image/photoURL must be strings.
    // FIX #1 (partial): profiles does not contain blockedUsers, so no guard needed here.
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if (isOwner(userId) || isAdmin()) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('twoFactorBackupCodes' in request.resource.data) &&
        !('twoFactorSecret' in request.resource.data) &&
        !('fcmToken' in request.resource.data) &&
        !('fcmTokens' in request.resource.data) &&
        // FIX #2: Ensure media URL fields are strings (not objects/arrays) if present
        (!('image' in request.resource.data) || request.resource.data.image is string || request.resource.data.image == null) &&
        (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string || request.resource.data.photoURL == null) &&
        (!('coverUrl' in request.resource.data) || request.resource.data.coverUrl is string || request.resource.data.coverUrl == null) &&
        (!('coverPhoto' in request.resource.data) || request.resource.data.coverPhoto is string || request.resource.data.coverPhoto == null);
      allow delete: if isOwner(userId) || isAdmin();

      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
      match /login_history/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // FIX #1: Users — blockedUsers field can only be written by the owner.
    // FIX #2: Media URL fields (photoURL) must be strings if present.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(userId) || isAdmin()) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordReset' in request.resource.data) &&
        (!('isAdmin' in request.resource.data) || isAdmin() || (resource != null && 'isAdmin' in resource.data && request.resource.data.isAdmin == resource.data.isAdmin)) &&
        // FIX #1: blockedUsers can only be written by the owner (not by admins or other users)
        (isOwner(userId) || !('blockedUsers' in request.resource.data) || (resource != null && 'blockedUsers' in resource.data && request.resource.data.blockedUsers == resource.data.blockedUsers)) &&
        // FIX #2: photoURL must be a string if present
        (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string || request.resource.data.photoURL == null);
      allow delete: if isOwner(userId) || isAdmin();
      
      // Sensitive private data in subcollection
      match /private/{document} {
        allow read, write: if isOwner(userId);
      }
    }

    // Conversations
    // FIX #5: Block enforcement (whether the target has blocked the requester) is enforced
    // server-side in the Express /api/messaging/conversations route, which checks
    // blockedUsers before creating. Firestore rules enforce participant membership integrity.
    match /conversations/{convoId} {
      allow read: if isSignedIn() && 
        request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && 
        request.auth.uid in request.resource.data.participants;
        
      // Prevent participants array manipulation
      allow update: if isSignedIn() && 
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
        
      // Only creator or participant can delete entire conversation
      allow delete: if isSignedIn() && 
        (resource.data.createdBy == request.auth.uid || request.auth.uid in resource.data.participants);

      // FIX #6: Messages field shape validation — prevent arbitrary field injection
      match /messages/{messageId} {
        allow read: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants && 
          request.resource.data.senderId == request.auth.uid &&
          // FIX #6: Restrict message fields to known-safe keys only
          request.resource.data.keys().hasOnly([
            'senderId', 'text', 'mediaUrl', 'mediaType', 'mediaWidth', 'mediaHeight',
            'mediaDuration', 'createdAt', 'type', 'isSystem', 'status',
            'replyTo', 'replyToText', 'replyToSender'
          ]);
        allow update: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants && 
          resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants && 
          resource.data.senderId == request.auth.uid;
      }
    }


    // Notifications
    // FIX #4: Added 'system' and 'call_missed' / 'call_ended' to type allowlist.
    // All client-side notification creates must include senderId == request.auth.uid
    // OR senderId == 'system' (for system notifications — permitted by the isAdmin OR senderId check).
    match /notifications/{notifId} {
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.recipientId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
         
      allow create: if isSignedIn() && 
        // Either the sender is the current user, OR it's a system notification marked by admin,
        // OR senderId is 'system' (used by Settings.jsx system notifications)
        (request.resource.data.senderId == request.auth.uid || 
         request.resource.data.senderId == 'system' ||
         isAdmin()) &&
        request.resource.data.recipientId is string &&
        (isAdmin() || request.resource.data.type in [
          'message', 'messages', 'follow', 'casting', 'casting_match',
          'review', 'call_missed', 'call_ended', 'system'
        ]);
        
      allow update, delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.recipientId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
    }

    // Casting Calls
    match /casting_calls/{callId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && 
        (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Applications
    match /applications/{appId} {
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.creatorId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // FIX #3: Saved Calls — added missing update rule
    match /saved_calls/{saveId} {
      allow read, delete: if isSignedIn() && 
        resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid;
      // FIX #3: Allow owner to update their own saved calls
      allow update: if isSignedIn() && 
        resource.data.userId == request.auth.uid;
    }

    // WebRTC Calls
    match /calls/{callId} {
      allow read, update, delete: if isSignedIn() && 
        (resource.data.callerId == request.auth.uid || 
         resource.data.calleeId == request.auth.uid);
      allow create: if isSignedIn() && 
        request.resource.data.callerId == request.auth.uid;

      match /callerCandidates/{candId} {
        allow read, write: if isSignedIn() && 
          (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || 
           get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
      match /calleeCandidates/{candId} {
        allow read, write: if isSignedIn() && 
          (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || 
           get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
    }

    // OTP Codes (2FA) — server Admin SDK only
    match /otpCodes/{userId} {
      allow read, write: if false;
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && 
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.targetType in [
          'user', 'casting', 'message'
        ] &&
        request.resource.data.reason in [
          'spam', 'harassment', 'inappropriate',
          'fake_profile', 'scam', 'other'
        ];
      allow update, delete: if isAdmin();
    }

    // Global Settings
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FIX #9: Admin Logs — write: false is intentional.
    // All writes go through the Express server using the Firebase Admin SDK,
    // which bypasses these rules. No client writes are permitted.
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK bypasses this — client writes are blocked intentionally
    }

    // FIX #8: Follows — explicit update: false to clarify intent
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.resource.data.followerId == request.auth.uid;
      allow update: if false; // Follow docs are immutable — delete and recreate if needed
      allow delete: if isSignedIn() && 
        resource.data.followerId == request.auth.uid;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    // Data Export Requests
    match /data_export_requests/{reqId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // One-time tokens (server-use only — Admin SDK)
    match /one_time_tokens/{tokenId} {
      allow read, write: if false;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
