rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // User Profiles
    match /profiles/{userId} {
      allow read: if true;
      allow write: if (isOwner(userId)
        && (resource == null
            ? (request.resource.data.verified == false)
            : (request.resource.data.verified == resource.data.verified)))
        || (isSignedIn() && getUserData().isAdmin == true);
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if (isOwner(userId)
        && (resource == null
            ? ((request.resource.data.isAdmin == false || request.auth.token.email == 'aniltimilsena53@gmail.com') && request.resource.data.role in ['Talent', 'Agent', 'Actor', 'Director', 'Model', 'Cinematographer', 'Editor', 'Dancer', 'Writer'])
            : ((request.resource.data.isAdmin == resource.data.isAdmin || request.auth.token.email == 'aniltimilsena53@gmail.com') && request.resource.data.role in ['Talent', 'Agent', 'Actor', 'Director', 'Model', 'Cinematographer', 'Editor', 'Dancer', 'Writer'])))
        || (isSignedIn() && getUserData().isAdmin == true);
    }

    // Conversations
    match /conversations/{convoId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      // Messages sub-collection
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants && (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == "system");
        allow update, delete: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants && resource.data.senderId == request.auth.uid;
      }
    }

    // Story Collections
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Story Replies
    match /story_replies/{replyId} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Casting Calls
    match /casting_calls/{callId} {
      allow read: if true;
      allow create: if isSignedIn() && (getUserData().role == 'Agent' || getUserData().role == 'Director' || getUserData().isAdmin == true);
      allow update: if isSignedIn() && (
        (resource.data.createdBy == request.auth.uid) ||
        (getUserData().isAdmin == true)
      );
      allow delete: if isSignedIn() && (
        (resource.data.createdBy == request.auth.uid) ||
        (getUserData().isAdmin == true)
      );
    }

    // Applications
    match /applications/{appId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.creatorId == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid && resource.data.status == 'pending';
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && resource.data.creatorId == request.auth.uid && request.resource.data.status in ['pending', 'accepted', 'rejected'];
    }

    // Saved Calls
    match /saved_calls/{saveId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // WebRTC Calls
    match /calls/{callId} {
      allow read, update, delete: if isSignedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.callerId == request.auth.uid;

      match /callerCandidates/{candId} {
        allow read, write: if isSignedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }

      match /calleeCandidates/{candId} {
        allow read, write: if isSignedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isSignedIn() && getUserData().isAdmin == true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && getUserData().isAdmin == true;
    }

    // Global Settings
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isSignedIn() && getUserData().isAdmin == true;
    }

    // Admin Logs
    match /admin_logs/{logId} {
      allow read, write: if isSignedIn() && getUserData().isAdmin == true;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
