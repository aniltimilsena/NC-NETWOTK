# ==============================================================================
# NepalCasts — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' (for local frontend development) and configure
# these on your local development and production hosting environments.

# ------------------------------------------------------------------------------
# 1. Clerk Authentication
# ------------------------------------------------------------------------------
# Grab this from your Clerk Dashboard (https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY_HERE

# ------------------------------------------------------------------------------
# 2. Firebase App Settings (Client)
# ------------------------------------------------------------------------------
# Your Firebase Web App configuration credentials (https://console.firebase.google.com)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=nc-network-10d0b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nc-network-10d0b
VITE_FIREBASE_STORAGE_BUCKET=nc-network-10d0b.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID_HERE
VITE_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID_HERE
VITE_FIREBASE_DATABASE_URL=https://nc-network-10d0b-default-rtdb.asia-southeast1.firebasedatabase.app/

# ------------------------------------------------------------------------------
# 3. Web Push Notifications (Firebase Cloud Messaging)
# ------------------------------------------------------------------------------
# FCM VAPID Key for web push notification subscription
VITE_FCM_VAPID_KEY=YOUR_FCM_VAPID_KEY_HERE
# Set to 'true' to suppress service worker registration errors on localhost
VITE_DISABLE_FCM_LOCALHOST=true

# ------------------------------------------------------------------------------
# 4. OneSignal (Mobile Push / In-App Messaging)
# ------------------------------------------------------------------------------
VITE_ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID_HERE

# ------------------------------------------------------------------------------
# 5. WebRTC Calling / TURN Server (Optional)
# ------------------------------------------------------------------------------
# Custom TURN server coordinates for WebRTC call connection traversal
VITE_TURN_SERVER=turn:your.turn.server:443
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_CREDENTIAL=your_turn_password

# ------------------------------------------------------------------------------
# 6. API Connection (Client Router Proxy)
# ------------------------------------------------------------------------------
# API server origin connection endpoint (defaults to '/api' in client proxy if empty)
VITE_API_URL=/api
APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 7. Server Settings (Express API Node Server)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# CORS origin access control list (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://nc-netwotk.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 8. Cloudinary (Media Ingestion)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME_HERE
CLOUDINARY_UPLOAD_PRESET=stored_media
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY_HERE
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET_HERE

# ------------------------------------------------------------------------------
# 9. Redis Cache / Rate Limiting (Optional)
# ------------------------------------------------------------------------------
# Fallback to local memory rate limiter if left empty
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
