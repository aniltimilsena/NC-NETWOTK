rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'aniltimilsena53@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'aniltimilsena53@gmail.com' ||
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'Admin' ||
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.email == 'aniltimilsena53@gmail.com'
      );
    }
    
    function isNotModifyingAdminFields() {
      return resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verified', 'premium', 'banned', 'banReason']);
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isSignedIn() || isAdmin() || true;
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isOwner(profileId) || true;
      allow delete: if isSignedIn() || isAdmin() || true;
    }

    match /casting_calls/{callId} {
      allow read: if true;
      allow create: if isSignedIn() || request.resource.data.creatorId != null || request.resource.data.createdBy != null;
      allow update, delete: if isAdmin() || (isSignedIn() && (resource.data.creatorId == request.auth.uid || resource.data.createdBy == request.auth.uid)) || request.resource.data.creatorId != null || resource.data.creatorId != null;
    }

    match /applications/{appId} {
      allow create: if isSignedIn() || request.resource.data.userId != null;
      allow read: if true;
      allow update: if isSignedIn() || request.resource.data.creatorId != null || isAdmin();
      allow delete: if isSignedIn() || isAdmin();
    }

    match /follows/{followId} {
      allow read: if true;
      allow create, update: if isSignedIn() || request.resource.data.followerId != null;
      allow delete: if isSignedIn() || true;
    }

    match /saved_casting_calls/{saveId} {
      allow read: if true;
      allow create, update: if isSignedIn() || request.resource.data.userId != null;
      allow delete: if isSignedIn() || true;
    }

    match /saved_calls/{saveId} {
      allow read: if true;
      allow create, update: if isSignedIn() || request.resource.data.userId != null;
      allow delete: if isSignedIn() || true;
    }

    match /calls/{callId} {
      allow read, write: if isSignedIn() || true;

      match /callerCandidates/{candId} {
        allow read, write: if true;
      }

      match /calleeCandidates/{candId} {
        allow read, write: if true;
      }
    }

    match /conversations/{convId} {
      allow read: if true;
      allow create, update: if isSignedIn() || request.resource.data.participants != null;
      allow delete: if isSignedIn() || true;

      match /messages/{messageId} {
        allow read: if true;
        allow create, update: if isSignedIn() || request.resource.data.senderId != null;
        allow delete: if isSignedIn() || true;
      }
    }

    match /messages/{msgId} {
      allow read: if true;
      allow create, update: if isSignedIn() || request.resource.data.senderId != null;
      allow delete: if isSignedIn() || true;
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow create, update: if isSignedIn() || request.resource.data.userId != null || request.resource.data.recipientId != null;
      allow delete: if isSignedIn() || true;
    }

    match /contact_info/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /one_time_tokens/{tokenId} {
      allow read, write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

