rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || request.auth.token.email == userId);
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'aniltimilsena53@gmail.com' ||
        request.auth.uid == 'aniltimilsena53@gmail.com'
      );
    }

    // Protect against privilege escalation: non-admins cannot set isAdmin or admin role
    function notEscalatingAdmin() {
      return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']) || isAdmin()) &&
             (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false || isAdmin()) &&
             (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role != 'admin' || isAdmin());
    }

    function validUserCreate() {
      return (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false || isAdmin()) &&
             (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role != 'admin' || isAdmin());
    }

    // Limit message payload sizes (max 2000 characters)
    function validMessage() {
      return (!request.resource.data.keys().hasAny(['text']) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
    }

    // --- USERS & PROFILES ---
    match /users/{userId} {
      allow read: if true;
      allow create, update: if validUserCreate();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create, update: if validUserCreate();
      allow delete: if isOwner(profileId) || isAdmin();

      match /login_history/{historyId} {
        allow read, write: if true;
      }
      match /sessions/{sessionId} {
        allow read, write: if true;
      }
    }

    // --- CASTING CALLS ---
    match /casting_calls/{callId} {
      allow read: if true;
      allow create: if (!request.resource.data.keys().hasAny(['title']) || (request.resource.data.title is string && request.resource.data.title.size() <= 200));
      allow update, delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
    }

    // --- APPLICATIONS ---
    match /applications/{appId} {
      allow read, create, update, delete: if true;
    }

    // --- SOCIAL, SAVED CALLS & FOLLOWS ---
    match /follows/{followId} {
      allow read, write: if true;
    }

    match /saved_casting_calls/{saveId} {
      allow read, write: if true;
    }

    match /saved_calls/{saveId} {
      allow read, write: if true;
    }

    // --- REALTIME WEBRTC CALLS ---
    match /calls/{callId} {
      allow read, write: if true;

      match /callerCandidates/{candId} {
        allow read, write: if true;
      }

      match /calleeCandidates/{candId} {
        allow read, write: if true;
      }
    }

    // --- CHATS & MESSAGING ---
    match /conversations/{convId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /messages/{msgId} {
      allow read, write: if true;
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // --- SENSITIVE CONTACT INFO ---
    match /contact_info/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin() || validUserCreate();
    }

    // --- ADMIN LOGS & TOKENS ---
    match /one_time_tokens/{tokenId} {
      allow read, write: if true;
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // --- SITE SETTINGS & SYSTEM ---
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if true;
    }
  }
}
