rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Admin determined solely by the custom claim set via setCustomUserClaims()
    // The claim is auto-set by assertAdmin() in Cloud Functions on first admin action.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Non-admins cannot escalate to admin or self-verify on user creation
    function validUserCreate() {
      return (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false || isAdmin()) &&
             (!request.resource.data.keys().hasAny(['role']) || (request.resource.data.role is string && request.resource.data.role.lower() != 'admin') || isAdmin()) &&
             (!request.resource.data.keys().hasAny(['verified', 'isVerified']) || (request.resource.data.verified == false && (!request.resource.data.keys().hasAny(['isVerified']) || request.resource.data.isVerified == false)) || isAdmin());
    }

    // Non-admins cannot escalate role, self-verify, or tamper with verified status on update
    function validUserUpdate() {
      let diff = request.resource.data.diff(resource.data);
      return (!diff.affectedKeys().hasAny(['isAdmin']) || isAdmin()) &&
             (!diff.affectedKeys().hasAny(['role']) || (request.resource.data.role is string && request.resource.data.role.lower() != 'admin') || isAdmin()) &&
             (!diff.affectedKeys().hasAny(['verified', 'isVerified']) || isAdmin());
    }

    // Limit message payload sizes (max 2000 characters)
    function validMessage() {
      return (!request.resource.data.keys().hasAny(['text']) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
    }

    // Check if the authenticated user is the creator/owner of a casting call
    function isCastingOwner(data) {
      return isSignedIn() && (
        request.auth.uid == data.createdBy ||
        request.auth.uid == data.creatorId ||
        request.auth.uid == data.created_by ||
        request.auth.uid == data.user_id ||
        (data.postedBy != null && data.postedBy.uid == request.auth.uid) ||
        (data.creator != null && data.creator.uid == request.auth.uid) ||
        (data.directorProfile != null && data.directorProfile.uid == request.auth.uid) ||
        (request.auth.token.email != null && data.creatorEmail != null && request.auth.token.email.lower() == data.creatorEmail.lower()) ||
        (request.auth.token.email != null && data.contactInfo != null && request.auth.token.email.lower() == data.contactInfo.lower()) ||
        isAdmin()
      );
    }

    // --- USERS & PROFILES ---
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) && validUserCreate();
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && validUserUpdate();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create: if isSignedIn() && (isOwner(profileId) || isAdmin()) && validUserCreate();
      allow update: if isSignedIn() && (isOwner(profileId) || isAdmin()) && validUserUpdate();
      allow delete: if isOwner(profileId) || isAdmin();

      match /login_history/{historyId} {
        allow read, write: if isOwner(profileId) || isAdmin();
      }
      match /sessions/{sessionId} {
        allow read, write: if isOwner(profileId) || isAdmin();
      }
    }

    // --- CASTING CALLS ---
    match /casting_calls/{callId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.creatorId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid ||
        (request.resource.data.postedBy != null && request.resource.data.postedBy.uid == request.auth.uid) ||
        isAdmin()
      );
      allow update, delete: if isCastingOwner(resource.data);
    }

    // --- APPLICATIONS ---
    match /applications/{appId} {
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.user_id == request.auth.uid ||
        isAdmin()
      );
      
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.user_id ||
        (request.auth.token.email != null && resource.data.userEmail != null && request.auth.token.email.lower() == resource.data.userEmail.lower()) ||
        (request.auth.token.email != null && resource.data.contactEmail != null && request.auth.token.email.lower() == resource.data.contactEmail.lower()) ||
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid == resource.data.createdBy ||
        isCastingOwner(resource.data) ||
        (resource.data.castingId != null && exists(/databases/$(database)/documents/casting_calls/$(resource.data.castingId)) && isCastingOwner(get(/databases/$(database)/documents/casting_calls/$(resource.data.castingId)).data)) ||
        isAdmin()
      );
      
      allow update: if isSignedIn() && (
        // Casting call owner or admin can update status / evaluate
        (
          request.auth.uid == resource.data.creatorId ||
          request.auth.uid == resource.data.createdBy ||
          isCastingOwner(resource.data) ||
          (resource.data.castingId != null && exists(/databases/$(database)/documents/casting_calls/$(resource.data.castingId)) && isCastingOwner(get(/databases/$(database)/documents/casting_calls/$(resource.data.castingId)).data)) ||
          isAdmin()
        ) ||
        // Applicant can update submission details, but CANNOT change application status (prevents self-approval)
        (
          (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.user_id) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
        )
      );

      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.user_id ||
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid == resource.data.createdBy ||
        isCastingOwner(resource.data) ||
        (resource.data.castingId != null && exists(/databases/$(database)/documents/casting_calls/$(resource.data.castingId)) && isCastingOwner(get(/databases/$(database)/documents/casting_calls/$(resource.data.castingId)).data)) ||
        isAdmin()
      );
    }

    // --- SOCIAL FOLLOWS ---
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.followerId &&
        request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.followerId || isAdmin()
      );
    }

    // --- SAVED CALLS ---
    match /saved_casting_calls/{saveId} {
      allow read, update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /saved_calls/{saveId} {
      allow read, update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // --- REALTIME WEBRTC CALLS ---
    match /calls/{callId} {
      allow create: if isSignedIn() && (
        request.resource.data.callerId == request.auth.uid || isAdmin()
      );
      allow read, update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.calleeId ||
        isAdmin()
      );

      match /callerCandidates/{candId} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId ||
          isAdmin()
        );
      }

      match /calleeCandidates/{candId} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId ||
          isAdmin()
        );
      }

      match /{document=**} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId ||
          isAdmin()
        );
      }
    }

    // --- CHATS & MESSAGING ---
    match /conversations/{convId} {
      // Authenticated user must be a participant when creating a conversation
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.participants || isAdmin()
      );
      // Read/update/delete only for participants or admins
      allow read, update, delete: if isSignedIn() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants ||
          isAdmin()
        );

        allow create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants ||
          isAdmin()
        ) && (
          request.resource.data.senderId == request.auth.uid ||
          request.resource.data.senderId == "system" ||
          isAdmin()
        ) && validMessage();
        
        // Participants can only update their own messages (or update reactions/delivered/read flags)
        allow update: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants ||
          isAdmin()
        ) && (
          resource.data.senderId == request.auth.uid ||
          isAdmin() ||
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'senderId', 'type']))
        ) && validMessage();

        // Only original message sender or admin can delete the message
        allow delete: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants ||
          isAdmin()
        ) && (
          resource.data.senderId == request.auth.uid || isAdmin()
        );
      }

      match /{document=**} {
        allow read, write: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants ||
          isAdmin()
        );
      }
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow create: if isSignedIn() && (
        request.resource.data.senderId == request.auth.uid || isAdmin()
      );
      allow read, update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.recipientId ||
        request.auth.uid == resource.data.receiverId ||
        isAdmin()
      );
    }

    // --- SENSITIVE CONTACT INFO ---
    match /contact_info/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- ADMIN LOGS & ONE-TIME TOKENS ---
    match /one_time_tokens/{tokenId} {
      allow read, write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // --- SITE SETTINGS & SYSTEM ---
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.user_id == request.auth.uid ||
        isAdmin()
      );
      allow read, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && (
        request.resource.data.reporterId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow read, update, delete: if isAdmin();
    }

    // --- USER DATA EXPORT / GDPR REQUESTS ---
    match /data_requests/{requestId} {
      allow read, create: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == request.resource.data.userId ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == request.resource.data.reviewerId || isAdmin());
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.reviewerId || isAdmin());
    }
  }
}
