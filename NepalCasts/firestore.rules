rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'aniltimilsena53@gmail.com' ||
        request.auth.uid == 'aniltimilsena53@gmail.com'
      );
    }

    // --- USERS & PROFILES ---
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() || isAdmin();
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() || isAdmin();
    }

    // --- CASTING CALLS ---
    match /casting_calls/{callId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // --- APPLICATIONS ---
    match /applications/{appId} {
      allow read, write: if true;
    }

    // --- SOCIAL & FOLLOWS ---
    match /follows/{followId} {
      allow read, write: if true;
    }

    match /saved_casting_calls/{saveId} {
      allow read, write: if true;
    }

    match /saved_calls/{saveId} {
      allow read, write: if true;
    }

    // --- REALTIME WEBRTC CALLS ---
    match /calls/{callId} {
      allow read, write: if true;

      match /callerCandidates/{candId} {
        allow read, write: if true;
      }

      match /calleeCandidates/{candId} {
        allow read, write: if true;
      }
    }

    // --- CHATS & MESSAGING (Nested & Root) ---
    match /conversations/{convId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }

      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /messages/{msgId} {
      allow read, write: if true;
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // --- SENSITIVE CONTACT INFO ---
    match /contact_info/{userId} {
      allow read, write: if true;
    }

    // --- ADMIN LOGS & TOKENS ---
    match /one_time_tokens/{tokenId} {
      allow read, write: if true;
    }

    match /admin_logs/{logId} {
      allow read, write: if true;
    }

    // --- CATCH-ALL FALLBACK ---
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

