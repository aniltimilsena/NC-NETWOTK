rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }


    
    
    function isAdmin() {
      return isSignedIn() && 
        request.auth.token.get('admin', false) == true;
    }

    function isBanned() {
      return isSignedIn() &&
        request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'banned';
    }

    function isPremiumUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        ('premium' in get(/databases/$(database)/documents/users/$(userId)).data) &&
        get(/databases/$(database)/documents/users/$(userId)).data.premium == true;
    }

    function isBlockedBy(targetUserId) {
      return exists(/databases/$(database)/documents/users/$(targetUserId)) &&
        'blockedUsers' in get(/databases/$(database)/documents/users/$(targetUserId)).data &&
        get(/databases/$(database)/documents/users/$(targetUserId)).data.blockedUsers is list &&
        request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(targetUserId)).data.blockedUsers;
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /login_history/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      match /private/{document} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /contact_info/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /conversations/{convoId} {
      allow read, update, delete: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants || isAdmin());
        allow create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.recipientId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid ||
         resource.data.senderId == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn() && !isBanned() && 
        (request.resource.data.senderId == request.auth.uid || 
         request.resource.data.senderId == 'system' ||
         isAdmin());
      allow update, delete: if isSignedIn() && !isBanned() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.recipientId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid ||
         resource.data.senderId == request.auth.uid ||
         isAdmin());
    }

    // PUBLIC COLLECTION — Casting calls are publicly browsable.
    // Must NOT contain PII beyond userIds. Ensure createdBy is a userId, not email.
    match /casting_calls/{callId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned() && 
        (request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isSignedIn() && !isBanned() && 
        (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /applications/{appId} {
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && !isBanned() && 
        (request.resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && !isBanned() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.creatorId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && !isBanned() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /saved_calls/{saveId} {
      allow read, delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && !isBanned() && 
        (request.resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && !isBanned() && 
        (request.resource.data.userId == request.auth.uid);
    }

    match /calls/{callId} {
      allow read, update, delete: if isSignedIn() && 
        (resource.data.callerId == request.auth.uid || 
         resource.data.calleeId == request.auth.uid);
      allow create: if isSignedIn() && !isBanned() && 
        (request.resource.data.callerId == request.auth.uid &&
         request.resource.data.calleeId is string &&
         request.resource.data.calleeId != request.auth.uid &&
         !isBlockedBy(request.resource.data.calleeId)) &&
        (!('callerName' in request.resource.data) || (request.resource.data.callerName is string && request.resource.data.callerName.size() <= 100)) &&
        (!('calleeName' in request.resource.data) || (request.resource.data.calleeName is string && request.resource.data.calleeName.size() <= 100));

      match /callerCandidates/{candId} {
        allow read, write: if isSignedIn() && 
          (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || 
           get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
      match /calleeCandidates/{candId} {
        allow read, write: if isSignedIn() && 
          (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || 
           get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
    }

    match /otpCodes/{userId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && 
        (request.resource.data.reporterId == request.auth.uid) &&
        request.resource.data.targetType in [
          'user', 'casting', 'message'
        ] &&
        request.resource.data.reason in [
          'spam', 'harassment', 'inappropriate',
          'fake_profile', 'scam', 'other'
        ];
      allow update, delete: if isAdmin();
    }

    // PUBLIC COLLECTION — Contains only public app settings (theme, feature flags).
    // Must NOT contain API keys, secrets, or internal configuration.
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; 
    }

    // PUBLIC COLLECTION — Follow relationships are public (followerId → followingId).
    // Must NOT contain PII beyond userIds.
    match /follows/{followId} {
      allow read: if true;
      allow create, update: if isSignedIn() && !isBanned() && 
        (request.resource.data.followerId == request.auth.uid);
      allow delete: if isSignedIn() && !isBanned() && 
        (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid || isAdmin());
    }

    // PUBLIC COLLECTION — Reviews are publicly visible.
    // Contains reviewerId, targetUserId, rating, text. No sensitive PII.
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn() && !isBanned() && 
        (
          request.resource.data.reviewerId == request.auth.uid &&
          request.resource.data.targetUserId != request.auth.uid
        ) &&
        request.resource.data.reviewerId != null &&
        request.resource.data.targetUserId != request.resource.data.reviewerId &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0;

      allow update, delete: if isSignedIn() && !isBanned() && 
        (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    match /data_export_requests/{reqId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && !isBanned() && (request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    match /data_requests/{requestId} {
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && !isBanned() && 
        (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending'
        );
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Global Settings (Maintenance Mode, feature flags, categories)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SERVER-ONLY — Managed exclusively via Admin SDK (firebase-admin).
    // Client access is intentionally blocked. Used for data export download tokens.
    match /one_time_tokens/{tokenId} {
      allow read, write: if false;
    }

    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
