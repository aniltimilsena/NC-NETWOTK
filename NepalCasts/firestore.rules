rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return (isSignedIn() && (request.auth.uid == userId || request.auth.token.email == userId));
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'aniltimilsena53@gmail.com' ||
        request.auth.uid == 'aniltimilsena53@gmail.com'
      );
    }

    // Protect against privilege escalation: non-admins cannot set isAdmin or admin role
    function validUserCreate() {
      return (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false || isAdmin()) &&
             (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role != 'admin' || isAdmin());
    }

    // Limit message payload sizes (max 2000 characters)
    function validMessage() {
      return (!request.resource.data.keys().hasAny(['text']) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
    }

    // Check if the authenticated user is the creator/owner of a casting call
    function isCastingOwner(data) {
      return isSignedIn() && (
        request.auth.uid == data.createdBy ||
        request.auth.uid == data.creatorId ||
        request.auth.uid == data.created_by ||
        request.auth.uid == data.user_id ||
        (request.auth.token.email != null && data.creatorEmail != null && request.auth.token.email.lower() == data.creatorEmail.lower()) ||
        (request.auth.token.email != null && data.contactInfo != null && request.auth.token.email.lower() == data.contactInfo.lower()) ||
        isAdmin()
      );
    }

    // --- USERS & PROFILES (Compatible with Clerk Authentication) ---
    match /users/{userId} {
      allow read: if true;
      allow create, update: if validUserCreate();
      allow delete: if true;
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create, update: if validUserCreate();
      allow delete: if true;

      match /login_history/{historyId} {
        allow read, write: if true;
      }
      match /sessions/{sessionId} {
        allow read, write: if true;
      }
    }

    // --- CASTING CALLS ---
    match /casting_calls/{callId} {
      // Publicly viewable by anyone on the network
      allow read: if true;
      // Only authenticated users can publish new casting calls
      allow create: if isSignedIn();
      // Only the owner of the casting call or an admin can edit or delete it
      allow update, delete: if isCastingOwner(resource.data);
    }

    // --- APPLICATIONS ---
    match /applications/{appId} {
      // Any authenticated user can submit an audition application
      allow create: if isSignedIn();
      
      // ONLY the applicant who submitted it OR the creator of that casting call OR an admin can see the application
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.user_id ||
        (request.auth.token.email != null && resource.data.userEmail != null && request.auth.token.email.lower() == resource.data.userEmail.lower()) ||
        (request.auth.token.email != null && resource.data.contactEmail != null && request.auth.token.email.lower() == resource.data.contactEmail.lower()) ||
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid == resource.data.createdBy ||
        isCastingOwner(resource.data) ||
        (resource.data.castingId != null && exists(/databases/$(database)/documents/casting_calls/$(resource.data.castingId)) && isCastingOwner(get(/databases/$(database)/documents/casting_calls/$(resource.data.castingId)).data)) ||
        isAdmin()
      );
      
      // ONLY the applicant or the casting call owner can update (review/withdraw) or delete the application
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.user_id ||
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid == resource.data.createdBy ||
        isCastingOwner(resource.data) ||
        (resource.data.castingId != null && exists(/databases/$(database)/documents/casting_calls/$(resource.data.castingId)) && isCastingOwner(get(/databases/$(database)/documents/casting_calls/$(resource.data.castingId)).data)) ||
        isAdmin()
      );
    }

    // --- SOCIAL FOLLOWS & SAVED CALLS ---
    match /follows/{followId} {
      allow read, write: if true;
    }

    match /saved_casting_calls/{saveId} {
      allow read, write: if true;
    }

    match /saved_calls/{saveId} {
      allow read, write: if true;
    }

    // --- REALTIME WEBRTC CALLS ---
    match /calls/{callId} {
      allow read, write: if true;

      match /callerCandidates/{candId} {
        allow read, write: if true;
      }

      match /calleeCandidates/{candId} {
        allow read, write: if true;
      }

      match /{document=**} {
        allow read, write: if true;
      }
    }

    // --- CHATS & MESSAGING ---
    match /conversations/{convId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if validMessage();
      }

      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /messages/{msgId} {
      allow read, write: if validMessage();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // --- SENSITIVE CONTACT INFO ---
    match /contact_info/{userId} {
      allow read, write: if true;
    }

    // --- ADMIN LOGS & TOKENS ---
    match /one_time_tokens/{tokenId} {
      allow read, write: if true;
    }

    match /admin_logs/{logId} {
      allow read, write: if true;
    }

    // --- SITE SETTINGS & SYSTEM ---
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /feedback/{feedbackId} {
      allow read, create, write: if true;
    }

    match /reports/{reportId} {
      allow read, create, write: if true;
    }
  }
}
